# =============================================================================
#  EcolePay Adoption Center — configuration de PRODUCTION (modèle)
#  Copiez ce fichier en `.env` sur le serveur, puis remplissez les valeurs.
#  Ne committez JAMAIS le `.env` rempli (il contient des secrets).
# =============================================================================

APP_NAME="Adoption Center"
APP_ENV=production
APP_KEY=                       # généré par: php artisan key:generate
APP_DEBUG=false                # JAMAIS true en production
APP_URL=https://adoption.votre-domaine.ci

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Abidjan

# Logs : en prod, garder le niveau raisonnable.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
#  Base de données EAC (l'entrepôt — écoles, parents, faits, utilisateurs)
#  MySQL/MariaDB sur le VPS. C'est ICI que tournent les migrations.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecolepay_adoption_center
DB_USERNAME=eac_app
DB_PASSWORD=                   # mot de passe de l'utilisateur MySQL de l'app

# -----------------------------------------------------------------------------
#  Base SOURCE EcolePay (LECTURE SEULE) — lue par `php artisan eac:sync`
#  Base de production EcolePay (hébergement mutualisé Hostinger).
#  L'utilisateur MySQL fourni ici ne doit avoir QUE le privilège SELECT.
#  Depuis le VPS, il faut avoir autorisé l'IP du VPS dans hPanel > MySQL distant.
# -----------------------------------------------------------------------------
ECOLEPAY_DB_HOST=              # hôte MySQL distant EcolePay (ex. 123.45.67.89)
ECOLEPAY_DB_PORT=3306
ECOLEPAY_DB_DATABASE=u698699576_ecole
ECOLEPAY_DB_USERNAME=          # utilisateur en LECTURE SEULE (SELECT only)
ECOLEPAY_DB_PASSWORD=

# -----------------------------------------------------------------------------
#  Confidentialité : clé HMAC des téléphones parents.
#  NON rotative sans recalcul complet — la fixer une fois pour toutes.
#  Générer une valeur robuste, ex.: php -r "echo bin2hex(random_bytes(32));"
# -----------------------------------------------------------------------------
EAC_PHONE_HASH_KEY=

# -----------------------------------------------------------------------------
#  Sessions / cache / files d'attente
#  `database` fonctionne sans Redis. Passez à `redis` si Redis est installé.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # cookies uniquement en HTTPS
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis (optionnel — si installé sur le VPS)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
#  Assistant IA KATIA (optionnel) — la clé peut aussi être saisie dans l'UI
#  (Paramètres > KATIA). Si renseignée ici, elle sert de repli.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
#  E-mail (pour les envois futurs : alertes, invitations). Log par défaut.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@votre-domaine.ci"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
